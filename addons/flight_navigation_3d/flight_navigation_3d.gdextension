[configuration]

entry_symbol = "flight_navigation_3d_init"
compatibility_minimum = "4.3"
reloadable = true

[libraries]

linux.debug.x86_64 = "res://addons/flight_navigation_3d/bin/libflight_navigation_3d.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/flight_navigation_3d/bin/libflight_navigation_3d.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://addons/flight_navigation_3d/bin/libflight_navigation_3d.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/flight_navigation_3d/bin/libflight_navigation_3d.windows.template_release.x86_64.dll"
macos.debug = "res://addons/flight_navigation_3d/bin/libflight_navigation_3d.macos.template_debug.framework"
macos.release = "res://addons/flight_navigation_3d/bin/libflight_navigation_3d.macos.template_release.framework"
